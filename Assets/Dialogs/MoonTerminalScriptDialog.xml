<CanvasWidget xmlns="runtime-namespace:Game" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
	<StackPanelWidget Direction="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<CanvasWidget Size="Infinity, 36" HorizontalAlignment="Stretch" VerticalAlignment="Near">
			<RectangleWidget OutlineColor="0, 0, 0, 0" FillColor="0, 0, 0, 102" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Size="Infinity, Infinity"/>
			<LabelWidget Name="Title" Text="[MoonTerminalScriptDialog:1]" Color="255, 255, 255, 255" Margin="12, 0" VerticalAlignment="Center" HorizontalAlignment="Near"/>
			<StackPanelWidget Direction="Horizontal" HorizontalAlignment="Far" VerticalAlignment="Center" Margin="0, 0, 8, 0">
				<CanvasWidget Size="32, 32">
					<RectangleWidget Size="20, 20" Subtexture="{Textures/Gui/PlayFill}" FillColor="255, 255, 255, 200" OutlineColor="0, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" TextureLinearFilter="false"/>
					<ClickableWidget Name="RunButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
				</CanvasWidget>
				<CanvasWidget Size="4, 0"/>
				<CanvasWidget Size="32, 32">
					<RectangleWidget Size="20, 20" Subtexture="{Textures/Gui/PauseFill}" FillColor="255, 255, 255, 200" OutlineColor="0, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" TextureLinearFilter="false"/>
					<ClickableWidget Name="PauseButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
				</CanvasWidget>
				<CanvasWidget Size="4, 0"/>
				<CanvasWidget Size="32, 32">
					<RectangleWidget Size="20, 20" Subtexture="{Textures/Gui/StopFill}" FillColor="255, 255, 255, 200" OutlineColor="0, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" TextureLinearFilter="false"/>
					<ClickableWidget Name="StopButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
				</CanvasWidget>
				<CanvasWidget Size="20, 0"/>
				<CanvasWidget Size="32, 32">
					<RectangleWidget Size="20, 20" Subtexture="{Textures/Gui/SaveFill}" FillColor="255, 255, 255, 200" OutlineColor="0, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" TextureLinearFilter="true"/>
					<ClickableWidget Name="SaveButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
				</CanvasWidget>
				<CanvasWidget Size="4, 0"/>
				<CanvasWidget Size="32, 32">
					<RectangleWidget Size="20, 20" Subtexture="{Textures/Gui/CloseLine}" FillColor="255, 255, 255, 200" OutlineColor="0, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center" TextureLinearFilter="true"/>
					<ClickableWidget Name="CloseButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
				</CanvasWidget>
			</StackPanelWidget>
		</CanvasWidget>
		<CanvasWidget Name="CodePanel" Size="Infinity, Infinity" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
			<RectangleWidget OutlineColor="0, 0, 0, 0" FillColor="0, 0, 0, 102" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Size="Infinity, Infinity"/>
			<LuaCodeBoxWidget xmlns="runtime-namespace:EBoyTerminal" Name="ScriptText" Color="255, 255, 255, 255" Margin="12, 8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaximumLength="32768"/>
		</CanvasWidget>
		<StackPanelWidget Name="OutputSection" Direction="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Near">
			<CanvasWidget Size="Infinity, 28" HorizontalAlignment="Stretch" VerticalAlignment="Near">
				<RectangleWidget OutlineColor="0, 0, 0, 0" FillColor="0, 0, 0, 140" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Size="Infinity, Infinity"/>
				<LabelWidget Name="OutputTitle" Text="[MoonTerminalScriptDialog:2]" Color="200, 200, 200, 255" Margin="12, 0" VerticalAlignment="Center" HorizontalAlignment="Near"/>
				<LabelWidget Name="OutputToggleHint" Text="[MoonTerminalScriptDialog:3]" Color="160, 160, 160, 255" Margin="0, 0, 12, 0" VerticalAlignment="Center" HorizontalAlignment="Far"/>
				<ClickableWidget Name="OutputToggleButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SoundName="Audio/UI/ButtonClick"/>
			</CanvasWidget>
			<CanvasWidget Name="OutputBody" Size="Infinity, 140" HorizontalAlignment="Stretch" VerticalAlignment="Near">
				<RectangleWidget OutlineColor="0, 0, 0, 0" FillColor="0, 0, 0, 102" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Size="Infinity, Infinity"/>
				<ScrollPanelWidget Name="OutputScroll" Direction="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8, 6">
					<LabelWidget Name="OutputText" WordWrap="true" Color="120, 255, 120, 255" HorizontalAlignment="Stretch" VerticalAlignment="Near"/>
				</ScrollPanelWidget>
			</CanvasWidget>
		</StackPanelWidget>
	</StackPanelWidget>
</CanvasWidget>
